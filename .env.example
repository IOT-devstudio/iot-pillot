# iot-pillot 后端配置示例。
#
# 复制为 `.env` 并按需修改；`.env` 已被 .gitignore 忽略。
# 优先级：环境变量 > .env 文件 > 默认值。
# 字段定义见 `apps/api/internal/config/config.go`。

# HTTP 服务端口
IOT_PILOT_PORT=8080

# 模式：debug | release | test
IOT_PILOT_MODE=debug

# CORS 白名单（多个用逗号分隔）
IOT_PILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL（与 docker-compose.yml 默认账号对齐）
IOT_PILOT_DB_HOST=localhost
IOT_PILOT_DB_PORT=5432
IOT_PILOT_DB_USER=iot_pillot
IOT_PILOT_DB_PASSWORD=iot_pillot
IOT_PILOT_DB_NAME=iot_pillot

# SMTP（招新邀请、offer、感谢信发送）
IOT_PILOT_SMTP_HOST=smtp.example.com
IOT_PILOT_SMTP_PORT=587
IOT_PILOT_SMTP_USERNAME=
IOT_PILOT_SMTP_PASSWORD=
IOT_PILOT_SMTP_FROM=noreply@example.com
