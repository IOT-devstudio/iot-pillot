#!/usr/bin/env bash
# docker 打桩：记录调用，按 STUB_* 环境变量决定返回什么。
echo "docker $*" >> "$STUB_LOG"

case "$1 $2" in
  "inspect -f")
    # 区分两种 inspect：取镜像 ID vs 取端口绑定
    if printf '%s' "$*" | grep -q 'PortBindings'; then
      [ -n "${STUB_PREV_CPORT:-}" ] && echo "${STUB_PREV_CPORT}/tcp"
      exit 0
    fi
    if [ -n "${STUB_PREV_IMAGE:-}" ]; then echo "$STUB_PREV_IMAGE"; exit 0; fi
    exit 1     # 没有运行中的容器
    ;;
  "image inspect") exit 0 ;;
  "load "*|"load") exit 0 ;;
  "stop "*|"rm "*)  exit 0 ;;
  "run "*)
    if printf '%s' "$*" | grep -q -- '--entrypoint /usr/local/bin/iot-migrate'; then
      echo "MIGRATE_ARGS $*" >> "$STUB_LOG"
      # Only fixture credentials are used by this stub, never production config.
      echo "MIGRATE_ENV_PASSWORD ${IOT_PILOT_DB_PASSWORD:-}" >> "$STUB_LOG"
      exit "${STUB_MIGRATE_RC:-0}"
    fi
    echo "RUN_ARGS $*" >> "$STUB_LOG"
    echo "containerid123"
    exit 0
    ;;
  "stop "*|"rm "*) exit 0 ;;
  "logs "*) echo "(stub logs)"; exit 0 ;;
  "images "*) exit 0 ;;
  "rmi "*) exit 0 ;;
esac
exit 0
